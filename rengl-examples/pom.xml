<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.piitex</groupId>
        <artifactId>rengl-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>rengl-examples</artifactId>
    <name>RenGL examples</name>
    <description>Runnable demos of the engine. Not part of the RenGL aggregate artifact; run them from this folder, because they read their sample data by relative path.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-audio</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-video</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-webview</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-3d</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-vulkan</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Only UpscalingDemo and RayTracingDemo use it. It carries none of the vendors' libraries; they are found at run time. -->
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-upscale</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Only PhysicsDemo uses it, with -Drengl.demo.physics=physx. The natives are this machine's. -->
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-physx</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>de.fabmax</groupId>
            <artifactId>physx-jni</artifactId>
            <version>${physx-jni.version}</version>
            <classifier>${physx.natives}</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-spellcheck</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-tilemap</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-entity</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-charts</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-downloads</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-ui-file</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- rengl-core shades the Skia API into its jar and marks skiko-awt optional, so it is not passed on when rengl-core
             is a module (the IDE, mvn) rather than the shaded jar. The demos declare it with normal scope: IDE run
             configurations leave out provided-scope dependencies, which fails with NoClassDefFoundError on org.jetbrains.skia. -->
        <dependency>
            <groupId>org.jetbrains.skiko</groupId>
            <artifactId>skiko-awt</artifactId>
            <version>${skiko.version}</version>
        </dependency>
        <!-- The Skia native library, so the demos run from the IDE or from the command line. -->
        <dependency>
            <groupId>org.jetbrains.skiko</groupId>
            <artifactId>${skiko.runtime.artifact}</artifactId>
            <version>${skiko.version}</version>
        </dependency>
    </dependencies>
</project>
