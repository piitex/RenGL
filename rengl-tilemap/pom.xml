<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>me.piitex.engine</groupId>
        <artifactId>rengl-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>rengl-tilemap</artifactId>
    <name>RenGL tilemap</name>
    <description>Tile maps: Tiled-style layers, tilesets, collision and animated tiles, with Zstandard-compressed chunk data.</description>

    <dependencies>
        <dependency>
            <groupId>me.piitex.engine</groupId>
            <artifactId>rengl-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-zstd</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-zstd</artifactId>
            <classifier>${lwjgl.natives}</classifier>
        </dependency>
        <!--
          The Skia API is shaded into the rengl-core jar, not passed on as a dependency, so the modules that compile
          against it need it to build. It stays out of the published dependencies.
        -->
        <dependency>
            <groupId>org.jetbrains.skiko</groupId>
            <artifactId>skiko-awt</artifactId>
            <version>${skiko.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.skiko</groupId>
            <artifactId>${skiko.runtime.artifact}</artifactId>
            <version>${skiko.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <!-- Release only: the natives this module owns, per platform (parent pom, natives-bundle-* profiles). -->
                    <execution>
                        <id>natives-bundle</id>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>org.lwjgl:lwjgl-zstd:*:${lwjgl.natives}</include>
                                </includes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- All six platforms in one build (-Pnatives-bundle-all): every platform's natives, one natives-<platform> jar each. -->
        <profile>
            <id>natives-bundle-all</id>
            <activation>
                <property>
                    <name>natives.platform</name>
                    <value>all</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>unpack-natives</id>
                                <phase>prepare-package</phase>
                                <goals><goal>unpack</goal></goals>
                                <configuration>
                                    <excludes>META-INF/*.SF,META-INF/*.DSA,META-INF/*.RSA,META-INF/MANIFEST.MF,META-INF/INDEX.LIST,META-INF/versions/**,module-info.class</excludes>
                                    <artifactItems>
                                <artifactItem>
                                    <groupId>org.lwjgl</groupId>
                                    <artifactId>lwjgl-zstd</artifactId>
                                    <version>${lwjgl.version}</version>
                                    <classifier>natives-linux</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-linux</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.lwjgl</groupId>
                                    <artifactId>lwjgl-zstd</artifactId>
                                    <version>${lwjgl.version}</version>
                                    <classifier>natives-linux-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-linux-arm64</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.lwjgl</groupId>
                                    <artifactId>lwjgl-zstd</artifactId>
                                    <version>${lwjgl.version}</version>
                                    <classifier>natives-macos</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-macos</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.lwjgl</groupId>
                                    <artifactId>lwjgl-zstd</artifactId>
                                    <version>${lwjgl.version}</version>
                                    <classifier>natives-macos-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-macos-arm64</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.lwjgl</groupId>
                                    <artifactId>lwjgl-zstd</artifactId>
                                    <version>${lwjgl.version}</version>
                                    <classifier>natives-windows</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-windows</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.lwjgl</groupId>
                                    <artifactId>lwjgl-zstd</artifactId>
                                    <version>${lwjgl.version}</version>
                                    <classifier>natives-windows-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-windows-arm64</outputDirectory>
                                </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
