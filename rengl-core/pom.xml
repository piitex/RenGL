    <artifactId>rengl-core</artifactId>
    <name>RenGL core</name>
    <description>Window, rendering (OpenGL and Metal), UI, input, game loop and the other pieces every RenGL program uses.</description>

    <profiles>
        <!--
          MoltenVK (the macOS Vulkan layer) ships as the natives of lwjgl-vulkan, which has natives for macOS only.
          Moves to rengl-vulkan when Vulkan becomes its own module.
        -->
        <profile>
            <id>vulkan-natives-macos-x86_64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
                <property>
                    <name>!skipAutoNatives</name>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.lwjgl</groupId>
                    <artifactId>lwjgl-vulkan</artifactId>
                    <classifier>natives-macos</classifier>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>vulkan-natives-macos-aarch64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
                <property>
                    <name>!skipAutoNatives</name>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.lwjgl</groupId>
                    <artifactId>lwjgl-vulkan</artifactId>
                    <classifier>natives-macos-arm64</classifier>
                </dependency>
            </dependencies>
        </profile>
        <!-- The release bundles (activated by id from the command line, see the parent pom). -->
        <profile>
            <id>natives-bundle-macos-x86_64</id>
            <dependencies>
                <dependency>
                    <groupId>org.lwjgl</groupId>
                    <artifactId>lwjgl-vulkan</artifactId>
                    <classifier>natives-macos</classifier>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>natives-bundle-macos-aarch64</id>
            <dependencies>
                <dependency>
                    <groupId>org.lwjgl</groupId>
                    <artifactId>lwjgl-vulkan</artifactId>
                    <classifier>natives-macos-arm64</classifier>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <!-- Sample data for the demos, which read it from the source tree by path, not from the classpath. -->
                    <exclude>demo/**</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!-- Skiko's Java API (org.jetbrains.skia.*) is bundled into the rengl-core jar, so consumers do not need the
                 Compose dev repository it is published to. The dependency below is optional, which Maven does not pass
                 on, and the published pom stays as it is (a dependency-reduced pom would bake in the build machine's
                 platform profiles). The platform natives are in the natives-* jars (see the release profiles). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <id>bundle-skiko</id>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>org.jetbrains.skiko:skiko-awt</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>org.jetbrains.skiko:skiko-awt</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                    <!-- Release only: the natives this module owns, per platform (parent pom, natives-bundle-* profiles). -->
                    <execution>
                        <id>natives-bundle</id>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>org.lwjgl:*:*:${lwjgl.natives}</include>
                                    <include>org.jetbrains.skiko:${skiko.runtime.artifact}</include>
                                </includes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

