    <artifactId>rengl-core</artifactId>
    <name>RenGL core</name>
    <description>Window, rendering (OpenGL and Metal), UI, input, game loop and the other pieces every RenGL program uses.</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <!-- The core must stay light: what the other modules own must not creep back in, directly or through another dependency. -->
                    <execution>
                        <id>keep-the-core-light</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>me.piitex.engine:*</exclude>
                                        <exclude>org.lwjgl:lwjgl-openal</exclude>
                                        <exclude>org.lwjgl:lwjgl-opus</exclude>
                                        <exclude>com.googlecode.soundlibs:*</exclude>
                                        <exclude>org.lwjgl:lwjgl-vulkan</exclude>
                                        <exclude>org.lwjgl:lwjgl-assimp</exclude>
                                        <exclude>org.lwjgl:lwjgl-shaderc</exclude>
                                        <exclude>org.lwjgl:lwjgl-spvc</exclude>
                                        <exclude>org.lwjgl:lwjgl-vma</exclude>
                                        <exclude>org.lwjgl:lwjgl-zstd</exclude>
                                        <exclude>org.apache.lucene:*</exclude>
                                    </excludes>
                                    <message>rengl-core must not depend on a library that another RenGL module owns (see docs/modules.md).</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Skiko's Java API (org.jetbrains.skia.*) is bundled into the rengl-core jar, so consumers do not need the
                 Compose dev repository it is published to. The dependency below is optional, which Maven does not pass
                 on, and the published pom stays as it is (a dependency-reduced pom would bake in the build machine's
                 platform profiles). The platform natives are in the natives-* jars (see the release profiles). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <id>bundle-skiko</id>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>org.jetbrains.skiko:skiko-awt</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>org.jetbrains.skiko:skiko-awt</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                    <!-- Release only: the natives this module owns, per platform (parent pom, natives-bundle-* profiles). -->
                    <execution>
                        <id>natives-bundle</id>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>org.lwjgl:*:*:${lwjgl.natives}</include>
                                    <include>org.jetbrains.skiko:${skiko.runtime.artifact}</include>
                                </includes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.26.1</version>
        </dependency>
        <!--
          Deliberately API only. log4j-core resolves the machine hostname at startup
          (InetAddress.getLocalHost), which blocks ~5s on hosts whose name does not resolve.
          The API's built-in simple logger is used instead; see log4j2.simplelog.properties.
        -->
        <!--
          Platform-independent Java API classes (org.jetbrains.skia.*): needed on every
          platform, unlike the native runtime, which is why this is unconditional rather
          than living in one of the per-platform profiles below. They are shaded into the
          RenGL jar, so the dependency is optional and consumers never resolve it.
        -->
        <dependency>
            <groupId>org.jetbrains.skiko</groupId>
            <artifactId>skiko-awt</artifactId>
            <version>${skiko.version}</version>
            <!-- Optional: it is shaded into the RenGL jar (bundle-skiko below), so consumers must not resolve it. -->
            <optional>true</optional>
        </dependency>
        <!-- The Skiko native library for the platform being built. Optional so consumers never resolve it; a release build makes it normal so the natives bundle can include it. -->
        <dependency>
            <groupId>org.jetbrains.skiko</groupId>
            <artifactId>${skiko.runtime.artifact}</artifactId>
            <version>${skiko.version}</version>
            <optional>${skiko.runtime.optional}</optional>
        </dependency>
