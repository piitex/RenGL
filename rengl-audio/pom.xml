<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.piitex</groupId>
        <artifactId>rengl-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>rengl-audio</artifactId>
    <name>RenGL audio</name>
    <description>Sound effects and music: WAV, MP3, FLAC, Ogg Vorbis and Opus through OpenAL, with channels, 3D positioning and reverb.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Ogg Vorbis decoding (VorbisStream) uses stb_vorbis; lwjgl-stb and its natives come with rengl-core. -->
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-openal</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opus</artifactId>
        </dependency>
        <!-- Pure-Java MP3 decoder (LGPL). -->
        <dependency>
            <groupId>com.googlecode.soundlibs</groupId>
            <artifactId>jlayer</artifactId>
            <version>1.0.1-1</version>
            <exclusions>
                <!-- jlayer declares junit at compile scope for its own tests; nothing here needs it at runtime. -->
                <exclusion>
                    <groupId>junit</groupId>
                    <artifactId>junit</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-openal</artifactId>
            <classifier>${lwjgl.natives}</classifier>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-opus</artifactId>
            <classifier>${lwjgl.natives}</classifier>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <!-- Release only: the natives this module owns, per platform (parent pom, natives-bundle-* profiles). -->
                    <execution>
                        <id>natives-bundle</id>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>org.lwjgl:lwjgl-openal:*:${lwjgl.natives}</include>
                                    <include>org.lwjgl:lwjgl-opus:*:${lwjgl.natives}</include>
                                </includes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- All six platforms in one build (-Pnatives-bundle-all): every platform's natives, one natives-<platform> jar each. -->
        <profile>
            <id>natives-bundle-all</id>
            <activation>
                <property>
                    <name>natives.platform</name>
                    <value>all</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>unpack-natives</id>
                                <phase>prepare-package</phase>
                                <goals><goal>unpack</goal></goals>
                                <configuration>
                                    <excludes>META-INF/*.SF,META-INF/*.DSA,META-INF/*.RSA,META-INF/MANIFEST.MF,META-INF/INDEX.LIST,META-INF/versions/**,module-info.class</excludes>
                                    <artifactItems>
                                <artifactItem>
                                    <groupId>org.lwjgl</groupId>
                                    <artifactId>lwjgl-openal</artifactId>
                                    <version>${lwjgl.version}</version>
                                    <classifier>natives-linux</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-linux</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.lwjgl</groupId>
                                    <artifactId>lwjgl-openal</artifactId>
                                    <version>${lwjgl.version}</version>
                                    <classifier>natives-linux-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-linux-arm64</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.lwjgl</groupId>
                                    <artifactId>lwjgl-openal</artifactId>
                                    <version>${lwjgl.version}</version>
                                    <classifier>natives-macos</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-macos</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.lwjgl</groupId>
                                    <artifactId>lwjgl-openal</artifactId>
                                    <version>${lwjgl.version}</version>
                                    <classifier>natives-macos-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-macos-arm64</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.lwjgl</groupId>
                                    <artifactId>lwjgl-openal</artifactId>
                                    <version>${lwjgl.version}</version>
                                    <classifier>natives-windows</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-windows</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.lwjgl</groupId>
                                    <artifactId>lwjgl-openal</artifactId>
                                    <version>${lwjgl.version}</version>
                                    <classifier>natives-windows-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-windows-arm64</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.lwjgl</groupId>
                                    <artifactId>lwjgl-opus</artifactId>
                                    <version>${lwjgl.version}</version>
                                    <classifier>natives-linux</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-linux</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.lwjgl</groupId>
                                    <artifactId>lwjgl-opus</artifactId>
                                    <version>${lwjgl.version}</version>
                                    <classifier>natives-linux-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-linux-arm64</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.lwjgl</groupId>
                                    <artifactId>lwjgl-opus</artifactId>
                                    <version>${lwjgl.version}</version>
                                    <classifier>natives-macos</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-macos</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.lwjgl</groupId>
                                    <artifactId>lwjgl-opus</artifactId>
                                    <version>${lwjgl.version}</version>
                                    <classifier>natives-macos-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-macos-arm64</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.lwjgl</groupId>
                                    <artifactId>lwjgl-opus</artifactId>
                                    <version>${lwjgl.version}</version>
                                    <classifier>natives-windows</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-windows</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.lwjgl</groupId>
                                    <artifactId>lwjgl-opus</artifactId>
                                    <version>${lwjgl.version}</version>
                                    <classifier>natives-windows-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-windows-arm64</outputDirectory>
                                </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- The native libraries' license texts go into every natives jar (parent pom, natives-licenses). Must stay after the unpack execution. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
