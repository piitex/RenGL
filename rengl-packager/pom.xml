<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.piitex</groupId>
        <artifactId>rengl-parent</artifactId>
        <version>0.1.1</version>
    </parent>

    <artifactId>rengl-packager</artifactId>
    <name>RenGL packager</name>
    <description>Builds a native app-image (launcher, bundled Java runtime, jars) for Windows, macOS and Linux from any of them, without jpackage. Not part of the RenGL aggregate artifact; run it as a command-line tool. Also holds the RenGL window of a Windows setup.exe made with --installer-ui (package me.piitex.engine.installer).</description>

    <dependencies>
        <!-- Only the setup window (me.piitex.engine.installer) uses these. The packager itself runs from its own jar with no dependencies. -->
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- As in rengl-examples: rengl-core shades the Skia API into its jar and marks skiko-awt optional, so an app
             that depends on the module has to name both Skiko artifacts itself. -->
        <dependency>
            <groupId>org.jetbrains.skiko</groupId>
            <artifactId>skiko-awt</artifactId>
            <version>${skiko.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.skiko</groupId>
            <artifactId>${skiko.runtime.artifact}</artifactId>
            <version>${skiko.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <executions>
                    <!-- The packager: everything but the setup window. -->
                    <execution>
                        <id>default-jar</id>
                        <configuration>
                            <excludes>
                                <exclude>me/piitex/engine/installer/**</exclude>
                            </excludes>
                            <archive>
                                <manifest>
                                    <mainClass>me.piitex.engine.packager.Packager</mainClass>
                                </manifest>
                            </archive>
                        </configuration>
                    </execution>
                    <!-- The setup window. The packager takes one folder of jars (see "The input folder" in
                         docs/reference/packaging.md): this jar is written straight into target/ui-input and the dependency
                         plugin below puts every dependency beside it. The setup only runs on Windows x64, so build on
                         Windows, or pass -DskipAutoNatives -Dlwjgl.natives=natives-windows
                         -Dskiko.runtime.artifact=skiko-awt-runtime-windows-x64. -->
                    <execution>
                        <id>setup-window</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>ui</classifier>
                            <outputDirectory>${project.build.directory}/ui-input</outputDirectory>
                            <includes>
                                <include>me/piitex/engine/installer/**</include>
                            </includes>
                            <archive>
                                <manifest>
                                    <mainClass>me.piitex.engine.installer.InstallerMain</mainClass>
                                </manifest>
                            </archive>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>collect-ui-input</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/ui-input</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <excludeArtifactIds>junit</excludeArtifactIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
