<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.piitex</groupId>
        <artifactId>rengl-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <!--
      The whole engine in one dependency, as RenGL was before it was split into modules. It has no code of its own: the
      jar holds a marker file, and the dependencies bring every module. It stays a jar (not a pom) so that an existing
      <dependency> on io.github.piitex:RenGL, which does not say <type>pom</type>, keeps resolving.
      A project that wants less depends on the modules it uses instead; see docs/modules.md.
    -->
    <artifactId>RenGL</artifactId>
    <name>RenGL</name>
    <description>The whole RenGL engine: every module except the examples, as one dependency.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-audio</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-video</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-webview</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-vulkan</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-3d</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-spellcheck</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-tilemap</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-entity</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-charts</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-downloads</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.piitex</groupId>
            <artifactId>rengl-ui-file</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          The Skiko native library for the platform being built. rengl-core declares it optional, which Maven does not
          pass on, so it is declared here too for the natives bundle to find it (optional except in a release build).
        -->
        <dependency>
            <groupId>org.jetbrains.skiko</groupId>
            <artifactId>${skiko.runtime.artifact}</artifactId>
            <version>${skiko.version}</version>
            <optional>${skiko.runtime.optional}</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              This module has no Java code, so the Javadoc plugin makes no jar for it, and Maven Central refuses an upload
              without one. This attaches a -javadoc jar holding a page that says where the real documentation is.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <executions>
                    <execution>
                        <id>javadoc-placeholder</id>
                        <phase>package</phase>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>javadoc</classifier>
                            <classesDirectory>${project.basedir}/src/javadoc</classesDirectory>
                            <archive>
                                <addMavenDescriptor>false</addMavenDescriptor>
                            </archive>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <!--
                      Release only: one natives-<platform> jar with the natives of every module, so depending on RenGL and
                      its natives classifier works as it always did. The modules' own natives jars hold the same files.
                    -->
                    <execution>
                        <id>natives-bundle</id>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>org.lwjgl:*:*:${lwjgl.natives}</include>
                                    <include>org.jetbrains.skiko:${skiko.runtime.artifact}</include>
                                </includes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- All six platforms in one build (-Pnatives-bundle-all): the modules' natives jars, merged, so RenGL plus a natives classifier still works. -->
        <profile>
            <id>natives-bundle-all</id>
            <activation>
                <property>
                    <name>natives.platform</name>
                    <value>all</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>unpack-natives</id>
                                <phase>prepare-package</phase>
                                <goals><goal>unpack</goal></goals>
                                <configuration>
                                    <excludes>META-INF/*.SF,META-INF/*.DSA,META-INF/*.RSA,META-INF/MANIFEST.MF,META-INF/INDEX.LIST,META-INF/versions/**,module-info.class</excludes>
                                    <artifactItems>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-core</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-linux</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-linux</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-audio</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-linux</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-linux</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-3d</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-linux</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-linux</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-tilemap</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-linux</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-linux</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-core</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-linux-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-linux-arm64</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-audio</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-linux-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-linux-arm64</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-3d</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-linux-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-linux-arm64</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-tilemap</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-linux-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-linux-arm64</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-core</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-macos</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-macos</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-audio</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-macos</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-macos</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-3d</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-macos</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-macos</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-tilemap</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-macos</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-macos</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-core</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-macos-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-macos-arm64</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-audio</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-macos-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-macos-arm64</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-3d</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-macos-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-macos-arm64</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-tilemap</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-macos-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-macos-arm64</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-core</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-windows</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-windows</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-audio</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-windows</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-windows</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-3d</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-windows</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-windows</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-tilemap</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-windows</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-windows</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-core</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-windows-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-windows-arm64</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-audio</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-windows-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-windows-arm64</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-3d</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-windows-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-windows-arm64</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-tilemap</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-windows-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-windows-arm64</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-vulkan</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-macos</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-macos</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.piitex</groupId>
                                    <artifactId>rengl-vulkan</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>natives-macos-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-macos-arm64</outputDirectory>
                                </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
