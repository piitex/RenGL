<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Deliberately has no parent: a consumer that imports this BOM should not pick up the build's plugin and profile setup. -->
    <groupId>io.github.piitex</groupId>
    <artifactId>rengl-bom</artifactId>
    <version>0.1.1</version>
    <packaging>pom</packaging>

    <name>RenGL BOM</name>
    <description>Versions of every RenGL module. Import it, then declare the modules you use without a version.</description>
    <url>https://github.com/piitex/RenGL</url>
    <inceptionYear>2026</inceptionYear>

    <developers>
        <developer>
            <id>piitex</id>
            <name>Piitex</name>
            <url>https://github.com/piitex</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/piitex/RenGL.git</connection>
        <developerConnection>scm:git:git@github.com:piitex/RenGL.git</developerConnection>
        <url>https://github.com/piitex/RenGL</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/piitex/RenGL/issues</url>
    </issueManagement>

    <licenses>
        <license>
            <name>RenGL Open-Source-Game License 1.0</name>
            <url>https://github.com/piitex/RenGL/blob/main/LICENSE</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.piitex</groupId>
                <artifactId>rengl-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.piitex</groupId>
                <artifactId>rengl-audio</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.piitex</groupId>
                <artifactId>rengl-video</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.piitex</groupId>
                <artifactId>rengl-webview</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.piitex</groupId>
                <artifactId>rengl-3d</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.piitex</groupId>
                <artifactId>rengl-upscale</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.piitex</groupId>
                <artifactId>rengl-physx</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.piitex</groupId>
                <artifactId>rengl-vulkan</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.piitex</groupId>
                <artifactId>rengl-spellcheck</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.piitex</groupId>
                <artifactId>rengl-tilemap</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.piitex</groupId>
                <artifactId>rengl-entity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.piitex</groupId>
                <artifactId>rengl-charts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.piitex</groupId>
                <artifactId>rengl-downloads</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.piitex</groupId>
                <artifactId>rengl-ui-file</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.piitex</groupId>
                <artifactId>RenGL</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.piitex</groupId>
                <artifactId>rengl-natives-windows</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.piitex</groupId>
                <artifactId>rengl-natives-windows-arm64</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.piitex</groupId>
                <artifactId>rengl-natives-linux</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.piitex</groupId>
                <artifactId>rengl-natives-linux-arm64</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.piitex</groupId>
                <artifactId>rengl-natives-macos</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.piitex</groupId>
                <artifactId>rengl-natives-macos-arm64</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <!-- The BOM has no parent, so it needs its own copy of the root pom's release profile: it must be signed and go in the same Central bundle. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
