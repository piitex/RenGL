<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.piitex</groupId>
    <artifactId>rengl-parent</artifactId>
    <version>0.1.1</version>
    <packaging>pom</packaging>

    <name>RenGL parent</name>
    <description>Shared versions, plugin configuration and native-library profiles for the RenGL modules.</description>
    <url>https://github.com/piitex/RenGL</url>
    <inceptionYear>2026</inceptionYear>

    <developers>
        <developer>
            <id>piitex</id>
            <name>Piitex</name>
            <url>https://github.com/piitex</url>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/piitex/RenGL.git</connection>
        <developerConnection>scm:git:git@github.com:piitex/RenGL.git</developerConnection>
        <url>https://github.com/piitex/RenGL</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/piitex/RenGL/issues</url>
    </issueManagement>

    <licenses>
        <license>
            <name>RenGL Open-Source-Game License 1.0</name>
            <url>https://github.com/piitex/RenGL/blob/main/LICENSE</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>rengl-bom</module>
        <module>rengl-core</module>
        <module>rengl-audio</module>
        <module>rengl-video</module>
        <module>rengl-webview</module>
        <module>rengl-vulkan</module>
        <module>rengl-3d</module>
        <module>rengl-upscale</module>
        <module>rengl-physx</module>
        <module>rengl-spellcheck</module>
        <module>rengl-accessibility</module>
        <module>rengl-tilemap</module>
        <module>rengl-entity</module>
        <module>rengl-charts</module>
        <module>rengl-downloads</module>
        <module>rengl-ui-file</module>
        <module>rengl-all</module>
        <module>rengl-packager</module>
        <module>rengl-examples</module>
    </modules>

    <properties>
        <lwjgl.version>3.4.3</lwjgl.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <!-- The sources are UTF-8. Without this, a build whose default charset is not UTF-8 (a Windows console on code page 437 or 1252, for one) misreads them. -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Skiko 0.154.0 is the first release with Vulkan support. It is published to the Compose dev repository below, not Maven Central. -->
        <skiko.version>0.154.0</skiko.version>
        <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
        <junit.version>5.10.2</junit.version>
        <!-- JVM arguments for the test JVM. The macOS profile below adds -XstartOnFirstThread, which GLFW needs for the GPU tests. -->
        <rengl.test.jvmargs>--enable-native-access=ALL-UNNAMED</rengl.test.jvmargs>

        <!-- The physx-jni natives that rengl-physx tests on and the examples run on: this machine's, set by the physx-natives-* profiles below. There are none for Linux or Windows on arm64. -->
        <physx-jni.version>2.9.0</physx-jni.version>
        <physx.natives>natives-windows</physx.natives>
    </properties>

    <profiles>
        <profile>
            <id>physx-natives-linux</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>Linux</name>
                </os>
            </activation>
            <properties>
                <physx.natives>natives-linux</physx.natives>
            </properties>
        </profile>
        <profile>
            <id>physx-natives-macos-x86_64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <properties>
                <physx.natives>natives-macos</physx.natives>
            </properties>
        </profile>
        <profile>
            <id>physx-natives-macos-aarch64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <physx.natives>natives-macos-arm64</physx.natives>
            </properties>
        </profile>
        <profile>
            <id>test-macos</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <rengl.test.jvmargs>-XstartOnFirstThread --enable-native-access=ALL-UNNAMED</rengl.test.jvmargs>
            </properties>
        </profile>

        <!--
          The platform natives artifacts for a release: -Dnatives.platform=all adds the rengl-natives modules, six small
          artifacts (rengl-natives-windows, rengl-natives-linux-arm64, ...) that each hold the Skiko runtime of one platform
          and depend on LWJGL's own natives for it. They are left out of a normal build because they need all six Skiko
          runtimes. Nothing else in the build reads the property below.

          The properties are placeholders so the poms resolve when the host's lwjgl-natives-* profile is not active
          (IntelliJ passes -P !lwjgl-natives-<host> for every profile left unticked). When the host profile is active,
          it wins.
        -->
        <profile>
            <id>natives-bundle-all</id>
            <activation>
                <property>
                    <name>natives.platform</name>
                    <value>all</value>
                </property>
            </activation>
            <modules>
                <module>rengl-natives</module>
            </modules>
            <properties>
                <lwjgl.natives>natives-windows</lwjgl.natives>
                <skiko.runtime.artifact>skiko-awt-runtime-windows-x64</skiko.runtime.artifact>
            </properties>
        </profile>

        <!--
          The six dev profiles below resolve natives for whichever platform is BUILDING the
          project: fine for local dev and for running the demos, but useless to a downstream
          consumer. Maven does not evaluate a dependency's own <profiles> when another
          project just adds a dependency, so none of that activation logic reaches them.

          They only set properties. A module that owns native libraries declares its natives
          with <classifier>${lwjgl.natives}</classifier>, and the module that owns Skiko
          declares the Skiko runtime as ${skiko.runtime.artifact}. A module with extra natives
          for one platform only (the MoltenVK natives in rengl-vulkan, macOS only) adds its own
          profile; see that module's pom.

          -DskipAutoNatives turns the auto-detection off, so a release build can pick a
          platform explicitly with -P (see the release profiles).
        -->
        <profile>
            <id>lwjgl-natives-linux-amd64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>amd64</arch>
                </os>
                <property>
                    <name>!skipAutoNatives</name>
                </property>
            </activation>
            <properties>
                <lwjgl.natives>natives-linux</lwjgl.natives>
                <skiko.runtime.artifact>skiko-awt-runtime-linux-x64</skiko.runtime.artifact>
            </properties>
        </profile>
        <profile>
            <id>lwjgl-natives-linux-aarch64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>aarch64</arch>
                </os>
                <property>
                    <name>!skipAutoNatives</name>
                </property>
            </activation>
            <properties>
                <lwjgl.natives>natives-linux-arm64</lwjgl.natives>
                <skiko.runtime.artifact>skiko-awt-runtime-linux-arm64</skiko.runtime.artifact>
            </properties>
        </profile>
        <profile>
            <id>lwjgl-natives-macos-x86_64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
                <property>
                    <name>!skipAutoNatives</name>
                </property>
            </activation>
            <properties>
                <lwjgl.natives>natives-macos</lwjgl.natives>
                <skiko.runtime.artifact>skiko-awt-runtime-macos-x64</skiko.runtime.artifact>
            </properties>
        </profile>
        <profile>
            <id>lwjgl-natives-macos-aarch64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
                <property>
                    <name>!skipAutoNatives</name>
                </property>
            </activation>
            <properties>
                <lwjgl.natives>natives-macos-arm64</lwjgl.natives>
                <skiko.runtime.artifact>skiko-awt-runtime-macos-arm64</skiko.runtime.artifact>
            </properties>
        </profile>
        <profile>
            <id>lwjgl-natives-windows-amd64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
                <property>
                    <name>!skipAutoNatives</name>
                </property>
            </activation>
            <properties>
                <lwjgl.natives>natives-windows</lwjgl.natives>
                <skiko.runtime.artifact>skiko-awt-runtime-windows-x64</skiko.runtime.artifact>
            </properties>
        </profile>
        <profile>
            <id>lwjgl-natives-windows-aarch64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>aarch64</arch>
                </os>
                <property>
                    <name>!skipAutoNatives</name>
                </property>
            </activation>
            <properties>
                <lwjgl.natives>natives-windows-arm64</lwjgl.natives>
                <skiko.runtime.artifact>skiko-awt-runtime-windows-arm64</skiko.runtime.artifact>
            </properties>
        </profile>

        <!--
          Publishing to Maven Central. Not part of a normal build. The sources and Javadoc jars
          that Central requires are already built by every module (see the build below). This
          profile adds the other requirement, GPG signatures, and uploads the bundle:

            ./mvnw -Prelease -DskipTests -Dnatives.platform=all deploy

          (Not -DskipAutoNatives: the "all" bundle needs the host's own natives profile for its
          placeholders. On Windows, add -Dgpg.executable=... if gpg is not on the PATH.)

          It needs your GPG key (set up with gpg or the key's passphrase in an agent) and a
          Central Portal user token saved under the id "central" in ~/.m2/settings.xml. The
          upload stops at "validated"; the release is published by hand from the Central
          Portal once you have looked at it. Version 0.1.1 can be published once, ever.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                            <!-- The demos are not a library. -->
                            <excludeArtifacts>
                                <artifact>rengl-examples</artifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <repositories>
        <repository>
            <id>compose-dev</id>
            <url>https://redirector.kotlinlang.org/maven/compose-dev</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.lwjgl</groupId>
                <artifactId>lwjgl-bom</artifactId>
                <version>${lwjgl.version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <excludes>
                        <!-- Exclude macOS AppleDouble files -->
                        <exclude>**/._*</exclude>
                        <!-- If macOS is dropping the dot, exclude leading underscores -->
                        <exclude>**/_*</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <argLine>${rengl.test.jvmargs}</argLine>
                    <!-- One JVM for all test classes: the GPU tests start a window and the engine's static state is shared. -->
                    <reuseForks>true</reuseForks>
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <source>25</source>
                    <!-- Don't fail the build on JavaDoc style warnings. -->
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
