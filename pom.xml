<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>me.piitex.engine</groupId>
    <artifactId>rengl-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>RenGL parent</name>
    <description>Shared versions, plugin configuration and native-library profiles for the RenGL modules.</description>

    <licenses>
        <license>
            <name>RenGL Open-Source-Game License 1.0</name>
            <url>https://github.com/piitex/RenGL/blob/main/LICENSE</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>rengl-bom</module>
        <module>rengl-core</module>
        <module>rengl-audio</module>
        <module>rengl-video</module>
        <module>rengl-vulkan</module>
        <module>rengl-3d</module>
        <module>rengl-spellcheck</module>
        <module>rengl-tilemap</module>
        <module>rengl-entity</module>
        <module>rengl-charts</module>
        <module>rengl-downloads</module>
        <module>rengl-ui-file</module>
        <module>rengl-all</module>
        <module>rengl-examples</module>
    </modules>

    <properties>
        <lwjgl.version>3.4.3</lwjgl.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <!-- The sources are UTF-8. Without this, a build whose default charset is not UTF-8 (a Windows console on code page 437 or 1252, for one) misreads them. -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Skiko 0.154.0 is the first release with Vulkan support. It is published to the Compose dev repository below, not Maven Central. -->
        <skiko.version>0.154.0</skiko.version>
        <maven-shade-plugin.version>3.6.2</maven-shade-plugin.version>
        <junit.version>5.10.2</junit.version>
        <!-- JVM arguments for the test JVM. The macOS profile below adds -XstartOnFirstThread, which GLFW needs for the GPU tests. -->
        <rengl.test.jvmargs>--enable-native-access=ALL-UNNAMED</rengl.test.jvmargs>

        <!-- The natives bundle (see the release profiles below) is only built when a natives-bundle-* profile turns this off. -->
        <natives.bundle.skip>true</natives.bundle.skip>
        <!-- The Skiko runtime (native library) is optional in a dev build, so it never reaches a consumer; a release build makes it a normal dependency so the bundle can pick it up. -->
        <skiko.runtime.optional>true</skiko.runtime.optional>
    </properties>

    <profiles>
        <profile>
            <id>test-macos</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <rengl.test.jvmargs>-XstartOnFirstThread --enable-native-access=ALL-UNNAMED</rengl.test.jvmargs>
            </properties>
        </profile>

        <!--
          The six dev profiles below resolve natives for whichever platform is BUILDING the
          project: fine for local dev and for running the demos, but useless to a downstream
          consumer. Maven does not evaluate a dependency's own <profiles> when another
          project just adds a dependency, so none of that activation logic reaches them.

          They only set properties. A module that owns native libraries declares its natives
          with <classifier>${lwjgl.natives}</classifier>, and the module that owns Skiko
          declares the Skiko runtime as ${skiko.runtime.artifact}. A module with extra natives
          for one platform only (the MoltenVK natives in rengl-vulkan, macOS only) adds its own
          profile; see that module's pom.

          -DskipAutoNatives turns the auto-detection off, so a release build can pick a
          platform explicitly with -P (see the release profiles).
        -->
        <profile>
            <id>lwjgl-natives-linux-amd64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>amd64</arch>
                </os>
                <property>
                    <name>!skipAutoNatives</name>
                </property>
            </activation>
            <properties>
                <lwjgl.natives>natives-linux</lwjgl.natives>
                <skiko.runtime.artifact>skiko-awt-runtime-linux-x64</skiko.runtime.artifact>
            </properties>
        </profile>
        <profile>
            <id>lwjgl-natives-linux-aarch64</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                    <arch>aarch64</arch>
                </os>
                <property>
                    <name>!skipAutoNatives</name>
                </property>
            </activation>
            <properties>
                <lwjgl.natives>natives-linux-arm64</lwjgl.natives>
                <skiko.runtime.artifact>skiko-awt-runtime-linux-arm64</skiko.runtime.artifact>
            </properties>
        </profile>
        <profile>
            <id>lwjgl-natives-macos-x86_64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
                <property>
                    <name>!skipAutoNatives</name>
                </property>
            </activation>
            <properties>
                <lwjgl.natives>natives-macos</lwjgl.natives>
                <skiko.runtime.artifact>skiko-awt-runtime-macos-x64</skiko.runtime.artifact>
            </properties>
        </profile>
        <profile>
            <id>lwjgl-natives-macos-aarch64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
                <property>
                    <name>!skipAutoNatives</name>
                </property>
            </activation>
            <properties>
                <lwjgl.natives>natives-macos-arm64</lwjgl.natives>
                <skiko.runtime.artifact>skiko-awt-runtime-macos-arm64</skiko.runtime.artifact>
            </properties>
        </profile>
        <profile>
            <id>lwjgl-natives-windows-amd64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
                <property>
                    <name>!skipAutoNatives</name>
                </property>
            </activation>
            <properties>
                <lwjgl.natives>natives-windows</lwjgl.natives>
                <skiko.runtime.artifact>skiko-awt-runtime-windows-x64</skiko.runtime.artifact>
            </properties>
        </profile>
        <profile>
            <id>lwjgl-natives-windows-aarch64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>aarch64</arch>
                </os>
                <property>
                    <name>!skipAutoNatives</name>
                </property>
            </activation>
            <properties>
                <lwjgl.natives>natives-windows-arm64</lwjgl.natives>
                <skiko.runtime.artifact>skiko-awt-runtime-windows-arm64</skiko.runtime.artifact>
            </properties>
        </profile>

        <!--
          The six profiles below are the actual release mechanism. Each is activated manually
          (-P) and picks exactly one platform. A module that owns natives (see its pom) then
          shades ONLY those natives, with no RenGL classes and no LWJGL or Skiko API classes,
          into one small jar attached to that module under a "natives-<platform>" classifier,
          matching LWJGL's own naming convention. The module's natives are listed in the
          "natives-bundle" execution in its own pom; this file only supplies the platform.

          A consumer targeting one platform adds, for each RenGL module it uses that has
          natives, the module plus that classifier. The RenGL aggregate artifact collects every
          module's natives into a single natives-<platform> jar, so depending on RenGL and its
          classifier still works the way it did before the split.

          These share the lwjgl.natives property with the dev profiles above, so they can't be
          combined in one -P list (whichever profile's value "wins" would silently apply to all
          of them). Run one platform per invocation, and pass -DskipAutoNatives so the host
          machine's own OS-detected dev profile doesn't also activate:
            mvn -DskipAutoNatives -P natives-bundle-linux-amd64 package
            mvn -DskipAutoNatives -P natives-bundle-linux-aarch64 package
            mvn -DskipAutoNatives -P natives-bundle-macos-x86_64 package
            mvn -DskipAutoNatives -P natives-bundle-macos-aarch64 package
            mvn -DskipAutoNatives -P natives-bundle-windows-amd64 package
            mvn -DskipAutoNatives -P natives-bundle-windows-aarch64 package
          This only resolves and repackages already-published artifacts, so all six can be run
          from any single host OS: no cross-compilation, no target-platform execution needed.
        -->
        <profile>
            <id>natives-bundle-linux-amd64</id>
            <properties>
                <lwjgl.natives>natives-linux</lwjgl.natives>
                <skiko.runtime.artifact>skiko-awt-runtime-linux-x64</skiko.runtime.artifact>
                <natives.classifier>natives-linux</natives.classifier>
                <natives.bundle.skip>false</natives.bundle.skip>
                <skiko.runtime.optional>false</skiko.runtime.optional>
            </properties>
        </profile>
        <profile>
            <id>natives-bundle-linux-aarch64</id>
            <properties>
                <lwjgl.natives>natives-linux-arm64</lwjgl.natives>
                <skiko.runtime.artifact>skiko-awt-runtime-linux-arm64</skiko.runtime.artifact>
                <natives.classifier>natives-linux-arm64</natives.classifier>
                <natives.bundle.skip>false</natives.bundle.skip>
                <skiko.runtime.optional>false</skiko.runtime.optional>
            </properties>
        </profile>
        <profile>
            <id>natives-bundle-macos-x86_64</id>
            <properties>
                <lwjgl.natives>natives-macos</lwjgl.natives>
                <skiko.runtime.artifact>skiko-awt-runtime-macos-x64</skiko.runtime.artifact>
                <natives.classifier>natives-macos</natives.classifier>
                <natives.bundle.skip>false</natives.bundle.skip>
                <skiko.runtime.optional>false</skiko.runtime.optional>
            </properties>
        </profile>
        <profile>
            <id>natives-bundle-macos-aarch64</id>
            <properties>
                <lwjgl.natives>natives-macos-arm64</lwjgl.natives>
                <skiko.runtime.artifact>skiko-awt-runtime-macos-arm64</skiko.runtime.artifact>
                <natives.classifier>natives-macos-arm64</natives.classifier>
                <natives.bundle.skip>false</natives.bundle.skip>
                <skiko.runtime.optional>false</skiko.runtime.optional>
            </properties>
        </profile>
        <profile>
            <id>natives-bundle-windows-amd64</id>
            <properties>
                <lwjgl.natives>natives-windows</lwjgl.natives>
                <skiko.runtime.artifact>skiko-awt-runtime-windows-x64</skiko.runtime.artifact>
                <natives.classifier>natives-windows</natives.classifier>
                <natives.bundle.skip>false</natives.bundle.skip>
                <skiko.runtime.optional>false</skiko.runtime.optional>
            </properties>
        </profile>
        <profile>
            <id>natives-bundle-windows-aarch64</id>
            <properties>
                <lwjgl.natives>natives-windows-arm64</lwjgl.natives>
                <skiko.runtime.artifact>skiko-awt-runtime-windows-arm64</skiko.runtime.artifact>
                <natives.classifier>natives-windows-arm64</natives.classifier>
                <natives.bundle.skip>false</natives.bundle.skip>
                <skiko.runtime.optional>false</skiko.runtime.optional>
            </properties>
        </profile>
    </profiles>

    <repositories>
        <repository>
            <id>compose-dev</id>
            <url>https://redirector.kotlinlang.org/maven/compose-dev</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.lwjgl</groupId>
                <artifactId>lwjgl-bom</artifactId>
                <version>${lwjgl.version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                  The release natives bundle. A module that owns natives declares this plugin and the
                  "natives-bundle" execution with an artifactSet listing exactly those natives, e.g.
                    <include>org.lwjgl:lwjgl-openal:*:${lwjgl.natives}</include>
                  Without a natives-bundle-* profile the execution is skipped.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>natives-bundle</id>
                            <phase>package</phase>
                            <goals><goal>shade</goal></goals>
                            <configuration>
                                <skip>${natives.bundle.skip}</skip>
                                <shadedArtifactAttached>true</shadedArtifactAttached>
                                <shadedClassifierName>${natives.classifier}</shadedClassifierName>
                                <createDependencyReducedPom>false</createDependencyReducedPom>
                                <filters>
                                    <filter>
                                        <artifact>me.piitex.engine:*</artifact>
                                        <excludes>
                                            <exclude>**</exclude>
                                        </excludes>
                                    </filter>
                                    <filter>
                                        <artifact>*:*</artifact>
                                        <excludes>
                                            <exclude>META-INF/*.SF</exclude>
                                            <exclude>META-INF/*.DSA</exclude>
                                            <exclude>META-INF/*.RSA</exclude>
                                            <exclude>META-INF/MANIFEST.MF</exclude>
                                            <exclude>META-INF/INDEX.LIST</exclude>
                                            <exclude>META-INF/versions/**</exclude>
                                            <exclude>module-info.class</exclude>
                                        </excludes>
                                    </filter>
                                </filters>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <excludes>
                        <!-- Exclude macOS AppleDouble files -->
                        <exclude>**/._*</exclude>
                        <!-- If macOS is dropping the dot, exclude leading underscores -->
                        <exclude>**/_*</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <argLine>${rengl.test.jvmargs}</argLine>
                    <!-- One JVM for all test classes: the GPU tests start a window and the engine's static state is shared. -->
                    <reuseForks>true</reuseForks>
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <source>25</source>
                    <!-- Don't fail the build on JavaDoc style warnings. -->
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
