<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>me.piitex.engine</groupId>
        <artifactId>rengl-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>rengl-vulkan</artifactId>
    <name>RenGL Vulkan</name>
    <description>The Vulkan render backend (RenderAPI.VULKAN). Needed for the 3D layer on macOS, where there is no OpenGL, and a choice on every other platform.</description>

    <properties>
        <!-- lwjgl-vulkan has natives for macOS only (MoltenVK); the macOS release profiles below turn the bundle on. -->
        <natives.bundle.skip>true</natives.bundle.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>me.piitex.engine</groupId>
            <artifactId>rengl-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-vulkan</artifactId>
        </dependency>
        <!--
          The Skia API is shaded into the rengl-core jar, not passed on as a dependency, so the modules that compile
          against it need it to build. It stays out of the published dependencies.
        -->
        <dependency>
            <groupId>org.jetbrains.skiko</groupId>
            <artifactId>skiko-awt</artifactId>
            <version>${skiko.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- MoltenVK, the macOS Vulkan layer, ships as the natives of lwjgl-vulkan. Nothing to add on Windows and Linux, which use the system's Vulkan driver. -->
        <profile>
            <id>vulkan-natives-macos</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
                <property>
                    <name>!skipAutoNatives</name>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.lwjgl</groupId>
                    <artifactId>lwjgl-vulkan</artifactId>
                    <classifier>${lwjgl.natives}</classifier>
                </dependency>
            </dependencies>
        </profile>
        <!-- The release bundles for macOS (activated by id from the command line, see the parent pom). -->
        <profile>
            <id>natives-bundle-macos-x86_64</id>
            <activation>
                <property>
                    <name>natives.platform</name>
                    <value>macos-x86_64</value>
                </property>
            </activation>
            <properties>
                <natives.bundle.skip>false</natives.bundle.skip>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.lwjgl</groupId>
                    <artifactId>lwjgl-vulkan</artifactId>
                    <classifier>${lwjgl.natives}</classifier>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>natives-bundle-macos-aarch64</id>
            <activation>
                <property>
                    <name>natives.platform</name>
                    <value>macos-aarch64</value>
                </property>
            </activation>
            <properties>
                <natives.bundle.skip>false</natives.bundle.skip>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.lwjgl</groupId>
                    <artifactId>lwjgl-vulkan</artifactId>
                    <classifier>${lwjgl.natives}</classifier>
                </dependency>
            </dependencies>
        </profile>
        <!-- All six platforms in one build (-Pnatives-bundle-all): the MoltenVK natives, macOS only (LWJGL publishes no Vulkan natives for Windows or Linux). -->
        <profile>
            <id>natives-bundle-all</id>
            <activation>
                <property>
                    <name>natives.platform</name>
                    <value>all</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>unpack-natives</id>
                                <phase>prepare-package</phase>
                                <goals><goal>unpack</goal></goals>
                                <configuration>
                                    <excludes>META-INF/*.SF,META-INF/*.DSA,META-INF/*.RSA,META-INF/MANIFEST.MF,META-INF/INDEX.LIST,META-INF/versions/**,module-info.class</excludes>
                                    <artifactItems>
                                <artifactItem>
                                    <groupId>org.lwjgl</groupId>
                                    <artifactId>lwjgl-vulkan</artifactId>
                                    <version>${lwjgl.version}</version>
                                    <classifier>natives-macos</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-macos</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.lwjgl</groupId>
                                    <artifactId>lwjgl-vulkan</artifactId>
                                    <version>${lwjgl.version}</version>
                                    <classifier>natives-macos-arm64</classifier>
                                    <outputDirectory>${project.build.directory}/natives/natives-macos-arm64</outputDirectory>
                                </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <!-- Release only, macOS only: the natives this module owns (parent pom, natives-bundle-* profiles). -->
                    <execution>
                        <id>natives-bundle</id>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>org.lwjgl:lwjgl-vulkan:*:${lwjgl.natives}</include>
                                </includes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
